# ---------------------------------------------------------------------------
# Mizaan — environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Signing key for JWTs. If unset the app generates a random key at boot and
# logs a warning — sessions will not survive a restart, which is fine for a
# demo and wrong for anything real. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Token lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_MINUTES=1440

# SQLAlchemy URL. SQLite is used by default so the app boots with no setup.
# PostgreSQL (docker-compose supplies this value):
#   postgresql+psycopg://mizaan:mizaan@db:5432/mizaan
DATABASE_URL=sqlite:///./mizaan.db

# Comma-separated origins allowed to call the API from a browser.
# "*" is acceptable for local development only.
ALLOWED_ORIGINS=*

# 1 = production. Turns on HSTS and disables the permissive CORS fallback.
PRODUCTION=0

# Rate limits, requests per minute.
AUTH_RATE_LIMIT=10
WRITE_RATE_LIMIT=60

# Seed regions on first boot: name, gpu quota, gpus held, USD/GPU-hour.
# Override only if you are running this against your own capacity plan.
SEED_REGIONS=us-east:64:12:2.48,eu-west:32:8:2.61,ap-south:24:4:2.19

# Inference backend. Leave unset: this build ships no model server and the
# health endpoint reports backend=none rather than pretending otherwise.
# LLM_BASE_URL=
# LLM_API_KEY=
